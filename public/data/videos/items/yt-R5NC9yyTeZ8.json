  "sentences": [
    {
      "index": 0,
      "start": 0.26,
      "end": 4.03,
      "textEn": "- Hello and welcome back to English with Lucy.",
      "textVi": "- Xin chào và chào mừng trở lại với tiếng Anh cùng Lucy.",
      "wordCount": 8
    },
    {
